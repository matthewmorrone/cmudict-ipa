{
    "name": "matthewmorrone/cmudict-ipa",
    "description": "CMU pronunciation dictionary converter with IPA support",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "symfony/console": "^6.0",
        "symfony/filesystem": "^6.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "CmuDictIpa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CmuDictIpa\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    }
}